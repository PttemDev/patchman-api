# Tenant-specific overrides. Copy to `.env.tenant` (gitignored) and fill
# in for the target deployment. The BE auto-loads `.env` first; layer
# `.env.tenant` on top via your process manager / docker-compose env_file
# or by sourcing it before launching the binary.
#
# Empty values mean "use the safe default" — see be/.env.example for the
# semantics of each key.

# --- Database (per-client cluster) -----------------------------------
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=

# --- Identity ---------------------------------------------------------
# Friendly name for this backend, shown by GET /api/config so a desktop
# client connecting via patchman://connect?backend=… can label the remote.
# Empty = "PatchMan".
APP_NAME=

# --- Auth / access control -------------------------------------------
# Comma-separated email domains; empty = no restriction
ALLOWED_EMAIL_DOMAINS=
# Bootstrap admin email; empty = no auto-admin
DEFAULT_ADMIN_EMAIL=
# Comma-separated allowed FE origins for OAuth callbacks
ALLOWED_REDIRECT_ORIGINS=

# --- GitLab integration ----------------------------------------------
GITLAB_BASE_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_TOKEN_ENC_KEY=

# --- Operational integrations ----------------------------------------
SLACK_ERROR_WEBHOOK_URL=
REALTIME_ALLOWED_ORIGINS=

# --- Secrets ---------------------------------------------------------
JWT_SECRET=
