DB_HOST=localhost
DB_PORT=5432
DB_NAME=getman
DB_USER=getman
DB_PASSWORD=getman123
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production
PORT=8085

# ----------------------------------------------------------------------
# Tenant-specific values. Override per-deployment via .env.tenant (not
# committed) or whatever your secret-management layer mounts in. Empty
# values fall back to "no restriction" semantics so the same binary can
# be reused across clients without code changes.
# ----------------------------------------------------------------------

# Comma-separated email domain allow-list for Register/Login/SSO.
# Empty = no restriction (open registration). Accepts both forms:
#   ALLOWED_EMAIL_DOMAINS=example.com,example.org
#   ALLOWED_EMAIL_DOMAINS=@example.com
ALLOWED_EMAIL_DOMAINS=

# Bootstrap admin account. The matching user row (if any) is promoted
# to admin at migrate time and hard-protected from cross-admin demotion
# / password reset. Empty = no auto-admin.
DEFAULT_ADMIN_EMAIL=

# Comma-separated FE host allow-list for OAuth redirect URIs (GitLab
# integration + SSO). localhost:3000/5173 are always permitted so dev
# works out of the box. Empty in production rejects every non-local
# origin, which is the safe default.
#   ALLOWED_REDIRECT_ORIGINS=https://ui-prod.example.com,https://ui-test.example.com
ALLOWED_REDIRECT_ORIGINS=

# GitLab OAuth integration (Settings → Integrations → GitLab).
# GITLAB_BASE_URL points at the tenant's GitLab; the FE label uses
# VITE_GITLAB_HOSTNAME (set in fe/.env.tenant).
GITLAB_BASE_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# 32 bytes base64 — encrypts access/refresh tokens at rest
GITLAB_TOKEN_ENC_KEY=

# Slack incoming webhook for FE crash reports. Empty = feature off.
# Toggles in admin → "Crash reporting" decide which sources forward here.
SLACK_ERROR_WEBHOOK_URL=

# ----------------------------------------------------------------------
# Sessions
# ----------------------------------------------------------------------
# Sliding session lifetime and an optional idle timeout (Go durations,
# e.g. "720h", "72h"). SESSION_IDLE_TTL=0 (default) turns the idle check off.
SESSION_TTL=720h
SESSION_IDLE_TTL=0

# ----------------------------------------------------------------------
# GitHub sign-in (OAuth app). Both values empty = button hidden.
# Register <origin>/auth/github/callback (web) and
# patchman://auth/github/callback (desktop) as callback URLs.
# GITHUB_BASE_URL is github.com or a GitHub Enterprise Server root.
# ----------------------------------------------------------------------
GITHUB_BASE_URL=https://github.com
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ----------------------------------------------------------------------
# Google sign-in and "Connect Google Cloud" (OAuth clients). Empty = off.
# Redirect URIs: <origin>/auth/google/callback and
# patchman://auth/google/callback.
# GOOGLE_WORKSPACE_DOMAINS limits sign-in to those Workspace domains
# (checked server-side against the hd claim). The optional "external"
# client is used for Google Cloud connections from addresses outside
# those domains.
# ----------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAINS=
GOOGLE_OAUTH_EXTERNAL_CLIENT_ID=
GOOGLE_OAUTH_EXTERNAL_CLIENT_SECRET=

# BigQuery: admin ceiling for bytes scanned per query (e.g. "100GB").
# No user or connection limit can exceed it. Empty = no ceiling.
BIGQUERY_MAX_BYTES_CEILING=

# ----------------------------------------------------------------------
# Plugins
# ----------------------------------------------------------------------
# Trusted publisher keys for signed plugins: "Name=base64key,Name2=...".
PATCHMAN_PLUGIN_TRUSTED_KEYS=
# Private CIDRs plugins may reach on a hosted server (comma-separated).
# Empty = no private ranges.
PLUGIN_PRIVATE_CIDRS=
