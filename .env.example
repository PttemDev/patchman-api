DB_HOST=localhost
DB_PORT=5432
DB_NAME=getman
DB_USER=getman
DB_PASSWORD=getman123
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production
PORT=8085

# ----------------------------------------------------------------------
# Tenant-specific values. Override per-deployment via .env.tenant (not
# committed) or whatever your secret-management layer mounts in. Empty
# values fall back to "no restriction" semantics so the same binary can
# be reused across clients without code changes.
# ----------------------------------------------------------------------

# Comma-separated email domain allow-list for Register/Login/SSO.
# Empty = no restriction (open registration). Accepts both forms:
#   ALLOWED_EMAIL_DOMAINS=example.com,example.org
#   ALLOWED_EMAIL_DOMAINS=@example.com
ALLOWED_EMAIL_DOMAINS=

# Bootstrap admin account. The matching user row (if any) is promoted
# to admin at migrate time and hard-protected from cross-admin demotion
# / password reset. Empty = no auto-admin.
DEFAULT_ADMIN_EMAIL=

# Comma-separated FE host allow-list for OAuth redirect URIs (GitLab
# integration + SSO). localhost:3000/5173 are always permitted so dev
# works out of the box. Empty in production rejects every non-local
# origin, which is the safe default.
#   ALLOWED_REDIRECT_ORIGINS=https://ui-prod.example.com,https://ui-test.example.com
ALLOWED_REDIRECT_ORIGINS=

# GitLab OAuth integration (Settings → Integrations → GitLab).
# GITLAB_BASE_URL points at the tenant's GitLab; the FE label uses
# VITE_GITLAB_HOSTNAME (set in fe/.env.tenant).
GITLAB_BASE_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# 32 bytes base64 — encrypts access/refresh tokens at rest
GITLAB_TOKEN_ENC_KEY=

# Slack incoming webhook for FE crash reports. Empty = feature off.
# Toggles in admin → "Crash reporting" decide which sources forward here.
SLACK_ERROR_WEBHOOK_URL=
